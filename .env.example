# Realtrail environment template.
# Real values must NEVER be committed. Copy to a local file only if needed,
# and keep server-only vars in the Convex deployment (dashboard or
# `npx convex env set`) — NOT in .env.local.

# --- Client-safe (Vite; safe to expose in the browser bundle) ---
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# --- Server-only (Convex deployment env — set via `npx convex env set`) ---
CLERK_FRONTEND_API_URL=
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
OPENAI_TRIAGE_MODEL=
OPENAI_DRAFT_MODEL=
PUBLIC_APP_URL=
REALTRAIL_CONFIRMATION_TOKEN_TTL_HOURS=72
REALTRAIL_VENDOR_FOLLOWUP_HOURS=4
REALTRAIL_RESIDENT_REMINDER_HOURS=24
REALTRAIL_ESCALATION_HOURS=72
